{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "outputs": [
                "dist/**",
                ".output/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "dev": {
            "persistent": true,
            "cache": false
        },
        "format": {},
        "format:check": {},
        "lint": {},
        "lint:check": {},
        "test": {},
        "examples": {
            "dependsOn": [
                "build"
            ]
        },
        "type-check": {},
        "test:functional": {},
        "agdb_studio#test:functional": {
            "dependsOn": [
                "build"
            ]
        },
        "before-commit": {},
        "openapi": {
            "cache": false
        },
        "test_queries": {
            "cache": false
        },
        "regenerate": {
            "cache": false
        },
        "release:dev": {
            "cache": false,
            "dependsOn": [
                "build"
            ]
        }
    }
}
