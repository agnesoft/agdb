{
  "name": "examples_server_client_php",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@prettier/plugin-php": "catalog:",
    "prettier": "catalog:"
  },
  "scripts": {
    "format": "prettier --plugin @prettier/plugin-php --write src",
