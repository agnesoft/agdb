{
  "name": "agdb_server_image",
  "version": "0.0.0",
  "private": true,
  "description": "The agdb_server container image with the studio",
  "scripts": {
    "test:image": "bash test_image.sh",
    "release:image": "bash release_image.sh"
  },
  "agci": {
    "checks": [
      "test:image"
    ],
    "depends": [
      "agdb_server",
      "agdb_studio"
    ],
    "release": [
      "release:image"
    ],
    "release_dev": [
      "release:image"
    ]
  }
}
