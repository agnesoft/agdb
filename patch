+            Ok(Self {
+                version: field(0),
+                graph: StorageIndex(field(1)),
+                aliases: (StorageIndex(field(2)), StorageIndex(field(3))),
+                indexes: StorageIndex(field(4)),
+                values: StorageIndex(field(5)),
